{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GEOMETRY",
  "colors": {
    "primary": "#6E7CF6",
    "light": "#8B9AFF",
    "dark": "#4A56D4"
  },
  "favicon": "/logo/favicon.svg",
  "logo": {
    "light": "/logo/logo-light.svg",
    "dark": "/logo/logo-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["quickstart", "introduction", "connect-and-keys"]
      },
      {
        "group": "Tools",
        "pages": [
          "payload-shapes",
          "tools/get-date",
          "tools/get-compatibility",
          "tools/get-name"
        ]
      },
      {
        "group": "Reference",
        "pages": ["why-deterministic", "coverage", "astro-wheels", "cosmic-day-cards", "field-glossary", "http-api", "support", "faq"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "geometry.app",
        "href": "https://geometry.app"
      },
      {
        "label": "goqo.com",
        "href": "https://goqo.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/goqolabs/geometry-mcp"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.geometry.app"
    }
  },
  "redirects": [
    {
      "source": "/birth-day-cards",
      "destination": "/cosmic-day-cards"
    },
    {
      "source": "/tools/get-birthdate",
      "destination": "/tools/get-date"
    },
    {
      "source": "/calendar-boundaries",
      "destination": "/coverage#calendar-boundaries"
    },
    {
      "source": "/tools/overview",
      "destination": "/payload-shapes"
    },
    {
      "source": "/tools/get-card-for-birthdate",
      "destination": "/tools/get-date"
    },
    {
      "source": "/tools/get-day",
      "destination": "/tools/get-date#day-ruler"
    },
    {
      "source": "/tools/get-day-card",
      "destination": "/tools/get-date#day-ruler"
    }
  ]
}
